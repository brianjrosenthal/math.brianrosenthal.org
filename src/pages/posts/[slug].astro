---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fileUrl, loadPosts, longDate, pageCount, type PostEntry } from '../../lib/site';

export async function getStaticPaths() {
  return (await loadPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
---

<Base title={data.title} description={data.summary}>
  <article class="article">
    <header>
      <p class="eyebrow">{[data.level, ...data.topics].join(' · ')}</p>
      <h1>{data.title}</h1>
      <p class="standfirst">{data.summary}</p>
      <p class="meta">{longDate(data.date)} · {pageCount(data.pages)}</p>
      <a class="download" href={fileUrl(data.pdf)}>Download the PDF</a>
    </header>
    <div class="prose">
      <Content />
    </div>
    {
      data.thumb && (
        <a class="preview" href={fileUrl(data.pdf)}>
          <img src={fileUrl(data.thumb)} alt={`First page of ${data.title}`} />
        </a>
      )
    }
  </article>
</Base>
